{
 "schema": "omicstat.lit.discovery-profiles.v1",
 "note": "One profile per module (ENGINEERING_PLAN 2.2 step 2). epmc_query uses Europe PMC section search (METHODS:) with the package name AND a feature term of the analysis part; signal_regex must hit inside a Methods region of the open-access full text; parameters list the PACK D rows whose values are counted for section V, each with CANDIDATE regexes -- the extractor confirms or corrects every candidate from the text and writes 'not reported' when the paper does not state the value (no inference).",
 "min_year": 2020,
 "common_filter": "HAS_FT:Y AND OPEN_ACCESS:Y AND SRC:MED AND NOT PUB_TYPE:\"review\" AND NOT PUB_TYPE:\"preprint\" AND NOT PUB_TYPE:\"retracted publication\" AND FIRST_PDATE:[{min_year}-01-01 TO {today}]",
 "profiles": [
  {
   "module": "deseq2-wald",
   "epmc_query": "METHODS:\"DESeq2\" AND (METHODS:\"differentially expressed\" OR METHODS:\"differential expression\" OR METHODS:\"Wald\" OR METHODS:\"lfcShrink\")",
   "signal_regex": "DESeq2",
   "require_regex": "differential(?:ly)? express|Wald|lfcShrink|fold[- ]change",
   "exclude_regex": "(?i)\\bsingle[- ]cell\\b|\\bscRNA-seq\\b|\\bsnRNA-seq\\b|\\bpseudo-?bulk\\b|\\bmicrobiome\\b|\\b16S\\b|\\bprotocol\\b",
   "parameters": [
    {
     "parameter": "padj_cutoff",
     "pack": "D-08",
     "question": "Adjusted P (FDR) cutoff used to call genes differentially expressed",
     "regex": [
      "(?:adjusted p(?:[- ]values?)?|p[._ ]?adj(?:usted)?|padj|FDR|false discovery rate|q[- ]values?|Benjamini[- ]Hochberg[- ]adjusted p)[^.;]{0,60}?(?:<|≤|<=|less than|lower than|below|of)\\s*(?P<value>0?\\.\\d+|\\d+(?:\\.\\d+)?\\s*%)"
     ]
    },
    {
     "parameter": "lfc_filter",
     "pack": "D-07",
     "question": "Fold-change criterion applied AFTER the test (post hoc filter), e.g. |log2FC| > 1",
     "regex": [
      "(?:\\|\\s*)?log\\s*2\\s*[- ]?\\(?\\s*fold[- ]?change\\s*\\)?(?:\\s*\\|)?\\s*(?:\\(\\s*\\|?\\s*log2FC\\s*\\|?\\s*\\)\\s*)?(?:>|≥|>=|of at least|greater than|above|of more than|exceeding)\\s*(?P<value>\\d+(?:\\.\\d+)?)",
      "(?:\\|\\s*)?(?:log2FC|LFC|log2 FC)(?:\\s*\\|)?\\s*(?:>|≥|>=)\\s*(?P<value>\\d+(?:\\.\\d+)?)",
      "(?<!log2 )(?<!log2)fold[- ]change\\s*(?:>|≥|>=|of at least|greater than|of more than)\\s*(?P<value>\\d+(?:\\.\\d+)?)"
     ]
    },
    {
     "parameter": "lfc_threshold_test",
     "pack": "D-07",
     "question": "Fold-change threshold built into the test (results(lfcThreshold = ...))",
     "regex": [
      "lfcThreshold\\s*(?:=|of|set to)?\\s*(?P<value>\\d+(?:\\.\\d+)?)"
     ]
    },
    {
     "parameter": "shrinkage",
     "pack": "D-09",
     "question": "Log2 fold-change shrinkage estimator (apeglm / ashr / normal / none)",
     "regex": [
      "(?P<value>apeglm|ashr|lfcShrink|normal prior|betaPrior)"
     ]
    },
    {
     "parameter": "prefilter",
     "pack": "D-11",
     "question": "Low-count pre-filter rule (count threshold x number of samples)",
     "regex": [
      "(?:at least|≥|>=|more than|minimum of|greater than)\\s*(?P<value>\\d+)\\s*(?:raw |total |normali[sz]ed )?(?:reads|counts)",
      "(?:rowSums|row sums?)[^.;]{0,40}?(?:>=|≥|>)\\s*(?P<value>\\d+)"
     ]
    },
    {
     "parameter": "test",
     "pack": "D-02",
     "question": "Test used (Wald vs likelihood ratio)",
     "regex": [
      "(?P<value>Wald test|Wald statistic|likelihood[- ]ratio test|\\bLRT\\b)"
     ]
    },
    {
     "parameter": "p_adjust_method",
     "pack": "D-08",
     "question": "Multiple-testing adjustment",
     "regex": [
      "(?P<value>Benjamini[- –]Hochberg|Benjamini and Hochberg|\\bBH\\b|Bonferroni|\\bIHW\\b|Storey)"
     ]
    },
    {
     "parameter": "design",
     "pack": "D-01",
     "question": "Design formula / covariates adjusted for (e.g. ~ batch + condition)",
     "regex": [
      "(?:design(?: formula)?|model)\\s*(?:=|of|:|was)?\\s*(?P<value>~\\s*[A-Za-z0-9_.]+(?:\\s*[+*:]\\s*[A-Za-z0-9_.]+)*)"
     ]
    },
    {
     "parameter": "deseq2_version",
     "pack": "X",
     "question": "DESeq2 version reported",
     "regex": [
      "DESeq2\\s*\\(?\\s*(?:v(?:ersion)?\\.?\\s*)?(?P<value>1\\.\\d+(?:\\.\\d+)?)"
     ]
    }
   ]
  },
  {
   "module": "deseq2-qc",
   "epmc_query": "METHODS:\"DESeq2\" AND (METHODS:\"variance stabilizing\" OR METHODS:\"variance-stabilizing\" OR METHODS:\"vst\" OR METHODS:\"rlog\" OR METHODS:\"regularized log\")",
   "signal_regex": "(?:variance[- ]stabili[sz]\\w*|\\bvst\\b|varianceStabilizingTransformation|\\brlog\\b|regularized[- ]log\\w*)[^.;]{0,250}?(?:principal[- ]component|\\bPCA\\b|sample[- ](?:to[- ]sample )?distance|sample clustering|hierarchical clustering of (?:the )?samples|outlier|quality control|\\bQC\\b)|(?:principal[- ]component|\\bPCA\\b|sample[- ](?:to[- ]sample )?distance|outlier)[^.;]{0,250}?(?:variance[- ]stabili[sz]\\w*|\\bvst\\b|\\brlog\\b)",
   "require_regex": "DESeq2",
   "exclude_regex": "(?i)\\bsingle[- ]cell\\b|\\bscRNA-seq\\b|\\bsnRNA-seq\\b|\\bmicrobiome\\b|\\b16S\\b|\\bprotocol\\b|FindVariableFeatures",
   "parameters": [
    {
     "parameter": "transform",
     "pack": "D-QC1",
     "question": "Transformation used for QC / visualisation (vst or rlog)",
     "regex": [
      "(?P<value>variance[- ]stabili[sz]\\w* transform\\w*|\\bvst\\b|varianceStabilizingTransformation|\\brlog\\b|regularized[- ]log(?:arithm)?)"
     ]
    },
    {
     "parameter": "blind",
     "pack": "D-QC2",
     "question": "blind = TRUE / FALSE for the transformation",
     "regex": [
      "blind\\s*=\\s*(?P<value>TRUE|FALSE|T\\b|F\\b)",
      "(?P<value>blind(?:ed)? to (?:the )?(?:experimental )?design|not blind)"
     ]
    },
    {
     "parameter": "pca_ntop",
     "pack": "D-QC3",
     "question": "Number of most variable genes used for PCA",
     "regex": [
      "(?:top|most variable)\\s*(?P<value>\\d{2,5})\\s*(?:most )?(?:variable )?genes",
      "ntop\\s*=\\s*(?P<value>\\d+)"
     ]
    },
    {
     "parameter": "sample_distance",
     "pack": "D-QC4",
     "question": "Sample distance used for clustering / heatmap",
     "regex": [
      "(?P<value>Euclidean distance|Poisson distance|Pearson correlation|Spearman correlation|PoiClaClu)"
     ]
    },
    {
     "parameter": "outlier_rule",
     "pack": "D-QC5",
     "question": "Rule used to call / remove outlier samples",
     "regex": [
      "(?P<value>outlier[^.;]{0,80})"
     ]
    },
    {
     "parameter": "prefilter",
     "pack": "D-11",
     "question": "Low-count pre-filter rule (count threshold x number of samples)",
     "regex": [
      "(?:at least|≥|>=|more than|minimum of|greater than)\\s*(?P<value>\\d+)\\s*(?:raw |total |normali[sz]ed )?(?:reads|counts)",
      "(?:rowSums|row sums?)[^.;]{0,40}?(?:>=|≥|>)\\s*(?P<value>\\d+)"
     ]
    },
    {
     "parameter": "deseq2_version",
     "pack": "X",
     "question": "DESeq2 version reported",
     "regex": [
      "DESeq2\\s*\\(?\\s*(?:v(?:ersion)?\\.?\\s*)?(?P<value>1\\.\\d+(?:\\.\\d+)?)"
     ]
    }
   ],
   "note": "Signal tightened 2026-09-27 after extraction: the transformation must share a sentence with a sample-level QC use (PCA, sample distances, outliers); 10 of 30 first-round articles used vst/rlog for other purposes."
  },
  {
