     "pack": "D-CM1",
     "question": "Which test (camera, fry, roast, mroast)",
     "regex": [
      "(?P<value>\\bcamera\\b|\\bfry\\b|\\bmroast\\b|\\broast\\b)"
     ]
    },
    {
     "parameter": "inter_gene_cor",
     "pack": "D-CM2",
     "question": "inter.gene.cor setting (default 0.01) or estimated correlation",
     "regex": [
      "inter\\.gene\\.cor\\s*=\\s*(?P<value>[\\w.]+)|(?P<value2>inter-?gene correlation[^.;]{0,40})"
     ]
    },
    {
     "parameter": "gene_set_db",
     "pack": "D-CM3",
     "question": "Gene-set collections tested",
     "regex": [
      "(?P<value>Gene Ontology|\\bGO\\b(?:[- ](?:BP|CC|MF))?|biological process|\\bKEGG\\b|Reactome|MSigDB|Hallmark|WikiPathways|\\bC2\\b|\\bC5\\b|\\bC7\\b|DisGeNET|\\bDO\\b|Disease Ontology)"
     ]
    },
    {
     "parameter": "expression_input",
     "pack": "D-CM4",
     "question": "Input (voom object, logCPM, array log-expression)",
     "regex": [
      "(?P<value>voom|logCPM|log-?CPM|normali[sz]ed log2?[^.;]{0,30})"
     ]
    },
    {
     "parameter": "p_adjust_method",
     "pack": "D-CM5",
     "question": "Multiple-testing adjustment",
     "regex": [
      "(?P<value>Benjamini[- –]Hochberg|Benjamini and Hochberg|\\bBH\\b|Bonferroni|\\bBY\\b|Benjamini[- –]Yekutieli|Storey|q[- ]?value)"
     ]
    },
    {
     "parameter": "enrich_cutoff",
     "pack": "D-CM6",
     "question": "Significance cutoff for gene sets",
     "regex": [
      "(?:adjusted p(?:[- ]values?)?|p[._ ]?adj(?:usted)?|padj|FDR|false discovery rate|q[- ]?values?|Benjamini[- ]Hochberg[- ]adjusted p)[^.;]{0,60}?(?:<|≤|<=|less than|lower than|below|of)\\s*(?P<value>0?\\.\\d+|\\d+(?:\\.\\d+)?\\s*%)"
     ]
    },
    {
     "parameter": "limma_version",
     "pack": "X",
     "question": "limma version reported",
     "regex": [
      "limma\\s*\\(?\\s*(?:v(?:ersion)?\\.?\\s*)?(?P<value>\\d+\\.\\d+(?:\\.\\d+)?)"
     ]
    }
   ]
  }
 ]
}
