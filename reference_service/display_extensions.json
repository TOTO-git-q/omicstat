        "signal_regex": "\\bscanpy\\b[^.;]{0,180}(?:marker genes|annotation)|(?:marker genes|annotation)[^.;]{0,180}\\bscanpy\\b",
        "signal_require_regex": "\\bscanpy\\b",
        "exclude_regex": "\\b(?:review|protocol|benchmark)\\b",
        "profile_status": "weak",
        "validation_rounds": 0,
