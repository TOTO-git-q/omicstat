      "module": "scanpy-annotate",
      "entry_script": "scripts/run_scanpy_annotate.py",
      "discovery_profile": {
        "module": "scanpy-annotate",
        "epmc_query": "METHODS:\"scanpy\" AND (METHODS:\"marker genes\" OR METHODS:\"annotation\")",
