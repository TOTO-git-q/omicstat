{
  "schema": "omicstat.acceptance-fixture.v1",
  "prepare": [
    {
      "script": "tests/prepare_acceptance.py",
      "argv": [
        "{fixtures}"
      ]
    }
  ],
  "canonical": {
    "argv": [
      "--input",
      "{fixtures}/plate.csv",
      "--mode",
      "calibration",
      "--model",
      "LL4",
      "--blank-policy",
      "subtract-mean",
      "--max-cv",
      "20",
      "--lloq",
      ".05",
      "--uloq",
      "50",
      "--dose-unit",
      "ng/mL",
      "--ci-level",
      ".95",
      "--study-contract",
      "{fixtures}/contract.json",
      "--development-mode",
      "--seed",
      "20261015",
      "--outdir",
      "{outdir}",
      "--unit-col",
      "sample_id"
    ]
  },
  "anchor_runner": {
    "script": "tests/anchors.R",
    "argv": [
      "{anchor_results}",
      "{root}"
    ]
  },
  "figure_policy": "required"
}
