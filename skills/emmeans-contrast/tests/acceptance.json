  "canonical": {
    "argv": [
      "--from-run",
      "{fixtures}/upstream",
      "--factor",
      "period",
      "--weights",
      "equal",
      "--df-method",
      "asymptotic",
      "--adjust",
      "none",
      "--ci-level",
      ".95",
      "--study-contract",
      "{fixtures}/contract.json",
      "--development-mode",
      "--seed",
      "20261015",
      "--outdir",
