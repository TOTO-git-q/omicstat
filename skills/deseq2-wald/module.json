  "publication": {
    "rule_category": "design_conditional",
    "legacy_override": {
      "module": "deseq2-wald",
      "rule_id": "PUB-M-DESEQ2WALD-001",
      "category": "design_conditional",
      "severity": "hard_error",
      "reporting_guidelines": [
        "software, version, test and shrinkage method named in the Methods (PACK W)"
      ],
      "effect_table_policy": {
        "primary_metrics": [
          "log2fc",
          "padj"
        ],
        "allow_no_effect_table": true,
        "requirements": [
          "the feature table (tables/feature_table.csv) is the primary payload",
          "the number tested after pre-filtering is the denominator, not the rows supplied"
        ]
      },
      "artifact_aliases": {
        "tables/feature_table.csv": "primary_table",
        "results/*.json": "machine"
      },
      "artifact_expectations": [
        "feature table",
        "volcano plot",
        "MA plot",
        "QC rule results",
        "provenance",
        "methods draft"
      ],
      "required_diagnostics": [
        "QC rules DW-01..DW-12 from qc/qc_results.csv",
        "replicates per compared group (DW-03/DW-04)",
        "features with padj = NA and their filtered_reason (DW-07/DW-08)"
      ],
      "narrative_points": [
        "name the reference and target levels and the replicate numbers",
        "state that log2 fold changes are shrunken (apeglm) and P values come from the unshrunken Wald test",
        "a fold-change criterion is stated as the lfcThreshold null, never as a post hoc filter"
      ],
      "causal_language": {
        "forbidden": [
          "causal verbs for expression differences (e.g. 'X induces genes')"
        ],
        "restricted_to": [
          "'higher/lower expression in <target> than in <reference>'"
        ]
      }
    }
  },
  "status": "accepted",
