{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmicStat typed figure definition v1 (additive figure-spec.v1 extension)",
  "description": "Runtime validators additionally verify exact source hashes, keyed counts, ratios, comparison provenance, interval estimates, and display replay. This schema does not validate a statistical estimator.",
  "type": "object",
  "required": [
    "semantic_version",
    "quantity",
    "observation_unit",
    "independent_unit",
    "unit",
    "eligible_set",
    "subset",
    "aggregation",
    "layers",
    "ratios",
    "statistics",
    "comparisons",
    "source_conflicts",
    "notes"
  ],
  "properties": {
    "quantity": {
      "type": "string",
      "minLength": 1
    },
    "observation_unit": {
      "type": "string",
      "minLength": 1
    },
    "independent_unit": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "aggregation": {
      "type": "string",
      "minLength": 1
    },
    "semantic_version": {
      "const": "omicstat.figure-semantics.v1"
    },
    "numerator": {
      "type": [
        "object",
        "null"
      ]
    },
    "denominator": {
      "type": [
        "object",
        "null"
      ]
    },
    "eligible_set": {
      "type": "object",
      "required": [
        "status",
        "rule"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "subset": {
      "type": "object",
      "required": [
        "status",
        "rule"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "data_role",
          "quantity",
          "unit",
          "source_key",
          "source_ids",
          "source_sha256",
          "hash_algorithm",
          "raw_source",
          "nonfinite_cells",
          "population_id",
          "independent_unit",
          "independent_ids",
          "n_rows",
          "n_observations",
          "n_independent",
          "states",
          "uncertainty",
          "transform",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "population_id": {
            "type": "string",
            "minLength": 1
          },
          "independent_unit": {
            "type": "string",
            "minLength": 1
          },
          "data_role": {
            "enum": [
              "observed",
              "aggregate",
              "model_grid",
              "prediction",
              "partial_residual",
              "simulation_truth",
              "known_annotation",
              "fitted_cluster",
              "draw",
              "reference",
              "display_only"
            ]
          },
          "source_key": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "hash_algorithm": {
            "const": "omicstat.typed-table.sha256.v1"
          },
          "raw_source": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "string",
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "nonfinite_cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "column",
                "kind"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "column": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "positive_infinity",
                    "negative_infinity"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "independent_ids": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "n_rows": {
            "type": "integer",
            "minimum": 0
          },
          "n_observations": {
            "type": "integer",
            "minimum": 0
          },
          "n_independent": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "states": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "string",
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "uncertainty": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "none",
                  "distribution",
                  "observation_quantile",
                  "IQR",
                  "SD",
                  "SE",
                  "CI",
                  "CrI",
                  "PI",
                  "baseline_range",
                  "estimator_mapping"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "coverage_scope": {
                "enum": [
                  "pointwise",
                  "simultaneous_grid",
                  "simultaneous_continuous",
                  "distribution",
                  "not_applicable",
                  "unknown"
                ]
              },
              "resampling_unit": {
                "type": "string",
                "minLength": 1
              },
              "availability": {
                "enum": [
                  "available",
                  "partial",
                  "unavailable",
                  "not_applicable"
                ]
              },
              "level": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "rows": {
                "anyOf": [
                  {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": [
                          "number",
                          "string",
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "summary_coverage_required": {
                "type": "boolean"
              }
            },
            "required": [
              "target",
              "kind",
              "method",
              "coverage_scope",
              "resampling_unit",
              "availability",
              "summary_coverage_required"
            ],
            "additionalProperties": true
          },
          "transform": {
            "type": [
              "object",
              "null"
            ]
          },
          "provenance": {
            "type": [
              "object",
              "array"
            ]
          },
          "value_columns": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "ratios": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "statistics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statistic_kind",
          "source_ids",
          "values",
          "method",
          "adjustment",
          "family_id",
          "family_size",
          "null",
          "alternative",
          "threshold",
          "decision"
        ],
        "properties": {
          "statistic_kind": {
            "enum": [
              "raw_p",
              "adjusted_p",
              "qvalue",
              "local_fdr",
              "posterior_probability",
              "posterior_inclusion_probability"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_conflicts": {
      "type": "array"
    },
    "notes": {
      "type": [
        "object",
        "array"
      ]
    }
  },
  "additionalProperties": false
}
