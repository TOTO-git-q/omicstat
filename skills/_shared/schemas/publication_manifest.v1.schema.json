{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omicstat.local/schemas/publication_manifest.v1.schema.json",
  "title": "PublicationManifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "module",
    "status",
    "created_at",
    "engine",
    "exit_code",
    "outdir",
    "request",
    "software_versions",
    "random_seed",
    "inputs",
    "outputs",
    "qc",
    "rules_version",
    "integrity_exclusions",
    "publication_review",
    "artifact_index",
    "results_outline",
    "effect_table_validation",
    "serialization_warnings",
    "engine_outputs",
    "engine_anchor_digest",
    "value_map",
    "runtime",
    "validator",
    "finalizer",
    "rule_catalog_hashes",
    "literature_provenance",
    "structured_warnings"
  ],
  "properties": {
    "schema_version": {"const": "omicstat.publication-manifest.v1"},
    "run_id": {"type": "string", "format": "uuid"},
    "module": {"type": "string", "minLength": 1},
    "status": {"enum": ["blocked", "needs_input", "review_required", "ready_for_manuscript_integration"]},
    "created_at": {"type": "string", "format": "date-time"},
    "engine": {"enum": ["native", "container"]},
    "exit_code": {"type": ["integer", "null"]},
    "outdir": {"type": "string", "minLength": 1},
    "requested_outdir": {"type": ["string", "null"]},
    "request": {"type": "object", "additionalProperties": true},
    "software_versions": {
      "type": "object",
      "required": ["python", "mcp", "r", "execution_engine", "python_packages", "r_session_info", "r_packages", "repository", "module_entry_script", "container_image_id", "container_image_warning", "effect_validator_sha256", "publication_module_rules_sha256", "publication_universal_rules_sha256", "publication_finalizer_sha256"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "mcp": {"type": "string", "minLength": 1},
        "r": {"type": "string", "minLength": 1},
        "execution_engine": {"enum": ["native", "container"]},
        "python_packages": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "r_session_info": {"type": ["string", "null"], "minLength": 1},
        "r_packages": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "repository": {"type": "object", "required": ["commit", "dirty", "worktree_identity"], "properties": {"commit": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{40}$"}, "dirty": {"type": ["boolean", "null"]}, "worktree_identity": {"type": ["object", "null"], "required": ["status_sha256", "diff_sha256", "untracked_sha256", "code_inventory_sha256", "worktree_sha256", "code_inventory"], "properties": {"status_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "diff_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "untracked_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "code_inventory_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "worktree_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "code_inventory": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}, "additionalProperties": false}}}, "additionalProperties": false}, "package_identity": {"type": ["object", "null"], "required": ["source_tree", "inventory_sha256"], "properties": {"source_tree": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"}, "inventory_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}, "additionalProperties": false}}, "additionalProperties": false},
        "module_entry_script": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": ["string", "null"], "minLength": 1}, "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}}, "additionalProperties": false},
        "container_image_id": {"type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$"},
        "container_image_warning": {"type": ["string", "null"]},
        "effect_validator_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "publication_module_rules_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "publication_universal_rules_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "publication_finalizer_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "python_engine": {"type": ["object", "null"], "description": "Python lane (ENGINEERING_PLAN 10.6 item 4): interpreter, package versions and image ID of the omicstat-py engine; present only for run_*.py modules", "required": ["engine", "python", "packages"], "properties": {"engine": {"enum": ["native", "container"]}, "python": {"type": "string", "minLength": 1}, "packages": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}, "image_id": {"type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$"}, "render_image_id": {"type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$"}}, "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "random_seed": {"type": ["string", "number", "null"]},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/inputRecord"}},
    "outputs": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/fileRecord"}, {"type": "object", "properties": {"path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}}}]}},
    "qc": {"type": "object", "additionalProperties": true},
    "rules_version": {"type": "string", "minLength": 1},
    "integrity_exclusions": {"type": "array", "items": {"type": "string"}},
    "publication_review": {"type": "string"},
    "artifact_index": {"type": "string"},
    "results_outline": {"type": "string"},
    "value_map": {"type": "string"},
    "runtime": {"type": "object", "required": ["execution_engine", "versions", "container_image_id", "container_image_warning"], "properties": {"execution_engine": {"enum": ["native", "container"]}, "versions": {"type": "object", "required": ["python", "mcp", "r"], "properties": {"python": {"type": "string", "minLength": 1}, "mcp": {"type": "string", "minLength": 1}, "r": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "container_image_id": {"type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$"}, "container_image_warning": {"type": ["string", "null"]}}, "additionalProperties": false},
    "validator": {"type": "object", "required": ["effect_table", "path", "sha256", "status"], "properties": {"effect_table": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "status": {"enum": ["executed", "failed", "not_applicable"]}}, "additionalProperties": false},
    "finalizer": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}, "additionalProperties": false},
    "rule_catalog_hashes": {"type": "object", "required": ["universal", "module"], "properties": {"universal": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "module": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}, "additionalProperties": false},
    "literature_provenance": {"type": "object", "required": ["status", "citations"], "properties": {"status": {"enum": ["not_supplied", "pending_verification", "verified", "invalid"]}, "citations": {"type": "array"}}, "additionalProperties": true},
    "structured_warnings": {"type": "array", "items": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}, "additionalProperties": true}},
    "effect_table_validation": {"type": "object"},
    "serialization_warnings": {"type": "array", "items": {"type": "object"}},
    "engine_outputs": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/fileRecord"}, {"type": "object", "properties": {"path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}}}]}},
    "engine_anchor_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "upstream_runs": {"description": "omicstat: upstream run_id chain of a --from-run module, read by the MCP shell from objects/handoff.json in the run directory; an empty list when the run has no upstream. Optional so that manifests without a handoff remain valid.", "type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  },
  "$defs": {
    "inputRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!\\\\)(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "category": {"type": "string"},
        "media_type": {"type": "string"}
      }
    }
  }
}
