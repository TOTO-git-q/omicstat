{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omicstat.org/schemas/celltypist-model.v1.schema.json",
  "title": "Safe data-only CellTypist model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "engine_version",
    "features",
    "classes",
    "coef",
    "intercept",
    "mean",
    "scale",
    "with_mean",
    "description",
    "source_pickle_sha256"
  ],
  "properties": {
    "schema": {
      "const": "omicstat.celltypist-model.v1"
    },
    "engine_version": {
      "const": "1.7.1"
    },
    "features": {
      "type": "array",
      "minItems": 2,
      "maxItems": 30000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^|]+$"
      }
    },
    "classes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^|]+$"
      }
    },
    "coef": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "intercept": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "mean": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "scale": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "with_mean": {
      "type": "boolean"
    },
    "description": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "source_pickle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
