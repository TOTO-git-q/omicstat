    },
    {
      "original_id": "SS-04",
      "omicstat_id": "SSZ-04",
      "condition": "surv_design && (is.null(ctx$event_prob) || is.na(ctx$event_prob))"
    },
    {
      "original_id": "SS-05",
      "omicstat_id": "SSZ-05",
      "condition": "!is.null(ctx$ratio) && !is.na(ctx$ratio) && (ctx$ratio > 3 || ctx$ratio < 1 / 3)"
