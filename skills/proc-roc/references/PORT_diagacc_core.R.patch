-# .round_counts(): tp/fn/fp/tn are PARTICIPANT COUNTS -- always exact
-# integers by definition -- but pROC::coords() can return them with tiny
-# floating-point noise (observed: 25.99999999999999644729, not exactly 26)
-# from its internal threshold interpolation. Left uncorrected, that noise
-# reaches accuracy_from_counts() (harmless there, since sens/spec are still
-# ~correct to 1e-15) but then a *_fill()/"%d"-formatted reader-facing slot
-# for the raw count fails outright: R's sprintf("%d", x) requires an exactly
-# whole-number double, and 25.999999999999996 is not one. Rounding at the
-# single call site every 2x2 table in this module goes through means the
-# fix applies everywhere at once (same rationale as roc_counts_at() itself
-# being the one call site, spec MUST #1).
 .round_counts <- function(df) {
   for (cn in c("tp", "fn", "fp", "tn")) if (cn %in% names(df)) df[[cn]] <- round(df[[cn]])
   df
 }
 
