{
  "schema": "omicstat.acceptance-fixture.v1",
  "figure_policy": "required",
  "prepare": [
    {
      "script": "tests/prepare_acceptance.R",
      "argv": [
        "{fixtures}",
        "{root}"
      ]
    }
  ],
  "canonical": {
    "argv": [
      "--input",
      "{fixtures}/zeisel.rds",
      "--mt-genes",
      "{fixtures}/mt.txt",
      "--qc-mode",
      "mad",
      "--nmads",
      "3",
      "--species",
      "Mus_musculus",
      "--id-type",
      "symbol",
      "--outdir",
      "{outdir}",
      "--seed",
      "20260925",
      "--journal",
      "nature"
