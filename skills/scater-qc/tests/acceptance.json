  },
  "anchor_runner": {
    "script": "tests/anchors.R",
    "argv": [
      "{fixtures}/zeisel.rds",
      "{run1}",
      "{anchor_results}"
    ]
  },
  "owner_review": {
    "dataset_id": "zeisel",
    "receipt": "owner_dataset.json"
  }
