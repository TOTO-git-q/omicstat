{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dot to exec acceptance request",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "modules",
    "image_candidate",
    "stages",
    "write_golden",
    "fixtures_to_fetch",
    "full_regression",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "omicstat.exec-request.v1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^P[0-3]-[A-Za-z0-9]+$"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "image_candidate": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^env/(py/)?candidates/[^/]+$"
        }
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "enum": [
          "static",
          "anchors",
          "replay",
          "refusals",
          "chain",
          "figures",
          "golden",
          "seal",
          "regression"
        ]
      },
      "uniqueItems": true
    },
    "write_golden": {
      "const": false
    },
    "fixtures_to_fetch": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "full_regression": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "module_image_candidates": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+-[a-z0-9]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^env/(py/)?candidates/[^/]+$"
      }
    },
    "render_image_candidate": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^env/(py/)?candidates/[^/]+$"
        }
      ]
    },
    "source_locks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate",
          "path",
          "sha256",
          "required_packages"
        ],
        "properties": {
          "candidate": {
            "type": "string",
            "pattern": "^env/(py/)?candidates/[^/]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^env/(py/)?candidates/[^/]+/sources[.]lock[.]json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "required_packages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
