{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anchor definitions/results",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "metric",
      "expected",
      "tolerance",
      "source",
      "scope",
      "how"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "metric": {
        "type": "string",
        "minLength": 1
      },
      "expected": {},
      "tolerance": {
        "type": "number",
        "minimum": 0
      },
      "source": {
        "type": "string",
        "minLength": 1
      },
      "scope": {
        "type": "string",
        "minLength": 1
      },
      "how": {
        "enum": [
          "printed",
          "replay"
        ]
      },
      "obtained": {},
      "pass": {
        "type": "boolean"
      },
      "tolerance_kind": {
        "enum": [
          "absolute",
          "relative_floor_one"
        ]
      }
    },
    "additionalProperties": true
  }
}
